# Copy this file to .env before npm run a2a. Do not commit .env.
# The desk reads .env and does not override variables already set in the environment.
# Set the league code privately. It is not stored in this repo.
# If it is unset, the first start generates one and saves it under server/data/ (mode 0600).

A2A_LEAGUE_CODE=replace-with-a-private-code
