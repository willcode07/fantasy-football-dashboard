# Copy this file to .env before npm run a2a. Do not commit .env.
# The desk reads .env and does not override variables already set in the environment.
# Set both codes privately. They must be different.
# If either code is unset, the first start generates one and saves it under server/data/ (mode 0600).

A2A_LEAGUE_CODE=replace-with-a-private-code
A2A_COMMISSIONER_CODE=replace-with-a-private-commissioner-code
